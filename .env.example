# LLM provider chain, all free tiers. Leave blank to skip a provider.
# Default order: groq → gemini → openrouter → cerebras → mistral (override with LLM_PROVIDER_ORDER=a,b,c).
# Ollama is not in the default order (a local model would silently produce a low-confidence "answer" where
# the chain would otherwise honestly report "unknown") but can be added back with LLM_PROVIDER_ORDER=...,ollama.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OLLAMA_URL=http://localhost:11434

# Optional model overrides (comma-separated). OpenRouter models must end in ":free".
# GROQ_MODELS=openai/gpt-oss-120b
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# CEREBRAS_MODELS=gpt-oss-120b,qwen-3.8-27b
# MISTRAL_MODELS=mistral-small-latest,mistral-medium-latest
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# OLLAMA_MODELS=llama3.1

# Optional overrides
# DB_PATH=./data/app.db
